# ===========================================================================
# AgentOS environment configuration (copy to .env and fill in)
# Never commit real secrets. This file is safe to commit (placeholders only).
# ===========================================================================

# --- Core ---
APP_ENV=local
LOG_LEVEL=INFO
BACKEND_PORT=8000

# --- Database (PostgreSQL + pgvector) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentos
POSTGRES_USER=agentos
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://agentos:change-me@localhost:5432/agentos

# --- Redis (cache / queue / SSE pub-sub) ---
REDIS_URL=redis://localhost:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- GitHub OAuth App ---
# https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback
# Space-separated GitHub scopes for the OAuth flow
GITHUB_SCOPE=repo user:email

# --- Secret keys ---
# Fernet key (32 url-safe base64 bytes) used to encrypt stored OAuth tokens.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=change-me-session-secret
FERNET_KEY=change-me-fernert-key

# --- OpenAI (agent, embeddings, judge) ---
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDINGS_MODEL=openai/text-embedding-3-small

# --- OpenCode (agent, judge) ---
OPENCODE_API_KEY=your-opencode-api-key
OPENCODE_BASE_URL=base-url-of-opencode
OPENCODE_MODEL=model-name-for-opencode-agent
OPENCODE_JUDGE_MODEL=model-name-for-opencode-judge

# --- Embeddings ---
EMBEDDINGS_DIMENSIONS=1536
OPENCODE_MAX_TOKENS=8192

# Optional OpenRouter headers (credits / app identity)
# OPENROUTER_APP_NAME=AgentOS
# OPENROUTER_APP_URL=

# --- Evaluation ---
# Judge uses the same OpenRouter key; a strong reasoning model is recommended.
OPENCODE_JUDGE_MODEL=anthropic/claude-sonnet-4.5

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=120
RUN_CONCURRENCY_PER_USER=2

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Send Secure-flagged cookies (must be true in production HTTPS)
COOKIE_SECURE=false
